# VitalPet Android — Release Signing Configuration Example
# Copy this file to "keystore.properties" (already ignored by .gitignore)
# and fill in your actual production keystore details:
#
# Generate a new upload key with keytool if you don't have one:
# keytool -genkey -v -keystore vitalpet-upload-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias vitalpet-upload
#
storeFile=vitalpet-upload-key.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=vitalpet-upload
keyPassword=YOUR_KEY_PASSWORD
